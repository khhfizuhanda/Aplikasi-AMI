    if (ri >= rows.length) break;

    var s = stats[order[i]];

    rows[ri] =
      r3SetRowCellText_(
        rows[ri],
        1,
        String(s.MELAMPAUI || 0)
      );

    rows[ri] =
      r3SetRowCellText_(
        rows[ri],
        2,
        String(s.MENCAPAI || 0)
      );

    rows[ri] =
      r3SetRowCellText_(
        rows[ri],
        3,
        String(s['BELUM MENCAPAI'] || 0)
      );

    rows[ri] =
      r3SetRowCellText_(
        rows[ri],
        4,
        String(s.MENYIMPANG || 0)
      );
  }

  return r3RebuildTable_(tbl, rows);
}

