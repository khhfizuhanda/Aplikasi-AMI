/* ============================ FOOTER ============================ */

function r3PatchPageNumberFooter_(map) {
  var doc = map['word/document.xml'];

  if (!doc) return map;

  var xml = doc.getDataAsString();

  var sectRe =
    /<w:sectPr\b[\s\S]*?<\/w:sectPr>/g;

  var sects = [];
  var m;

  while ((m = sectRe.exec(xml)) !== null) {
    sects.push({
      start:m.index,
      end:sectRe.lastIndex,
      xml:m[0]
    });
  }

  if (!sects.length) return map;

  var newXml = '';
  var last = 0;

  for (var i = 0; i < sects.length; i++) {
    newXml +=
      xml.substring(
        last,
        sects[i].start
      );

    var s = sects[i].xml;

    // Bersihkan footer lama jika ada.
    s = s.replace(
      /<w:footerReference\b[^>]*\/>/g,
      ''
    );

    var insert =
      '<w:footerReference ' +
      'w:type="default" ' +
      'r:id="rIdAMIReportV3Footer"/>';

    if (i === 0) {
      insert +=
        '<w:titlePg/>' +
        '<w:pgNumType w:start="0"/>';
    }

    s = s.replace(
      /<w:sectPr\b([^>]*)>/,
      '<w:sectPr$1>' + insert
    );

    newXml += s;
    last = sects[i].end;
  }

  newXml += xml.substring(last);

  map['word/document.xml'] =
    Utilities.newBlob(
      newXml,
      'application/xml',
      'word/document.xml'
    );

  var relName =
    'word/_rels/document.xml.rels';

  var rels =
    map[relName].getDataAsString();

  if (
    rels.indexOf(
      'rIdAMIReportV3Footer'
    ) < 0
  ) {
    rels = rels.replace(
      '</Relationships>',
      '<Relationship ' +
      'Id="rIdAMIReportV3Footer" ' +
      'Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/footer" ' +
      'Target="footerAMIReportV3.xml"/>' +
      '</Relationships>'
    );
  }

  map[relName] =
    Utilities.newBlob(
      rels,
      'application/xml',
      relName
    );

  var ctName = '[Content_Types].xml';
  var types =
    map[ctName].getDataAsString();

  if (
    types.indexOf(
      '/word/footerAMIReportV3.xml'
    ) < 0
  ) {
    types = types.replace(
      '</Types>',
      '<Override ' +
      'PartName="/word/footerAMIReportV3.xml" ' +
      'ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.footer+xml"/>' +
      '</Types>'
    );
  }

  map[ctName] =
    Utilities.newBlob(
      types,
      'application/xml',
      ctName
    );

  var footer =
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<w:ftr ' +
    'xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">' +
      '<w:p>' +
        '<w:pPr><w:jc w:val="center"/></w:pPr>' +
        '<w:r>' +
          '<w:rPr>' +
            '<w:rFonts ' +
            'w:ascii="Times New Roman" ' +
            'w:hAnsi="Times New Roman"/>' +
            '<w:sz w:val="18"/>' +
          '</w:rPr>' +
          '<w:t xml:space="preserve">Halaman </w:t>' +
        '</w:r>' +
        '<w:fldSimple w:instr=" PAGE " w:dirty="true">' +
          '<w:r>' +
            '<w:rPr>' +
              '<w:rFonts ' +
              'w:ascii="Times New Roman" ' +
              'w:hAnsi="Times New Roman"/>' +
              '<w:sz w:val="18"/>' +
            '</w:rPr>' +
            '<w:t>1</w:t>' +
          '</w:r>' +
        '</w:fldSimple>' +
      '</w:p>' +
    '</w:ftr>';

  map['word/footerAMIReportV3.xml'] =
    Utilities.newBlob(
      footer,
      'application/xml',
      'word/footerAMIReportV3.xml'
    );

  if (map['word/settings.xml']) {
    var settings =
      map['word/settings.xml']
        .getDataAsString();

    if (
      settings.indexOf(
        '<w:updateFields'
      ) < 0
    ) {
      settings = settings.replace(
        '</w:settings>',
        '<w:updateFields w:val="true"/>' +
        '</w:settings>'
      );
    }

    map['word/settings.xml'] =
      Utilities.newBlob(
        settings,
        'application/xml',
        'word/settings.xml'
      );
  }

  return map;
}

/* ============================ BUILD ============================ */

function r3PatchDocument_(ctx) {
  var map = r3TemplateParts_();

  if (!map['word/document.xml']) {
    throw new Error(
      'Template laporan tidak memiliki word/document.xml.'
    );
  }

  var xml =
    map['word/document.xml']
      .getDataAsString();

  // LibreOffice/Google Docs dapat memperlakukan cached lastRenderedPageBreak
  // dari Word sebagai page break nyata dan menghasilkan halaman kosong.
  xml = xml.replace(/<w:lastRenderedPageBreak\s*\/>/g, '');

  var audit = ctx.audit;

  var isProdi =
    r3Clean_(audit.AuditiType) === 'PRODI';

  var lead =
    ctx.auditors[
      r3Clean_(ctx.team.LeadAuditorID)
    ] || {};

  var m1 =
    ctx.auditors[
      r3Clean_(ctx.team.Member1ID)
    ] || {};

  var m2 =
    ctx.auditors[
      r3Clean_(ctx.team.Member2ID)
    ] || {};

  // Cover values. Hanya nilai yang diganti; shape, font, ukuran, posisi, margin tidak diubah.
  xml =
    r3ReplaceExactText_(
      xml,
      'Agribisnis',
      r3Clean_(audit.AuditiName) || '-'
    );

  xml =
    r3ReplaceExactText_(
      xml,
      'Pertanian',
      isProdi
        ? (r3Clean_(audit.Fakultas) || '-')
        : (
            r3Clean_(audit.AuditiName) ||
            '-'
          )
    );

  if (isProdi && !r3Clean_(ctx.leader.name)) {
    throw new Error('Ketua Program Studi untuk ' + (r3Clean_(audit.AuditiName) || 'Prodi') + ' belum ditemukan pada MASTER_PIMPINAN. Atur Master Pimpinan dengan Level/Area Akses PRODI terlebih dahulu.');
  }
  xml = r3ReplaceParagraphValueAfterLabel_(xml, 'Ka. Prodi', ctx.leader.name || '-', 1);
  if (isProdi) r3AssertParagraphValueByLabel_(xml, 'Ka. Prodi', ctx.leader.name);

  xml =
    r3ReplaceExactText_(
      xml,
      'Arie Kartika, SH, MH',
      r3Clean_(lead.Nama) || '-',
      1
    );

  xml =
    r3ReplaceExactText_(
      xml,
      'Dr. M. Khahfi Zuhanda, S.Si, M.Si',
      r3Clean_(m1.Nama) || '-'
    );

  xml =
    r3ReplaceExactText_(
      xml,
      'Arnes Sembiring',
      r3Clean_(m2.Nama) || '-',
      1
    );

  xml =
    r3ReplaceExactText_(
      xml,
      'IX/2026',
      r3CycleLabel_(ctx.cycle),
      1
    );

  // Untuk auditi unit, label cover tetap pada posisi yang sama tetapi teks menyesuaikan.
  if (!isProdi) {
    xml =
      r3ReplaceExactText_(
        xml,
        'Program Studi',
        'Unit',
        1
      );

    xml =
      r3ReplaceExactText_(
        xml,
        'Fakultas',
        'Jenis Unit',
        1
      );

    xml =
      r3ReplaceExactText_(
        xml,
        'Ka. Prodi',
        ctx.leader.label,
        1
      );
  }

  // Narasi Ringkasan Eksekutif.
  var total = r3Assessed_(ctx);
  var pct = r3FulfillPct_(ctx);
  var neg =
    Number(
      ctx.counts['BELUM MENCAPAI'] ||
      0
    ) +
    Number(
      ctx.counts.MENYIMPANG ||
      0
    );

  var summary =
    'Audit Mutu Internal terhadap ' +
    r3Clean_(audit.AuditiName) +
    ' mencakup ' +
    ctx.assigns.length +
    ' butir standar. Sebanyak ' +
    total +
    ' butir telah memperoleh hasil audit, dengan tingkat pemenuhan sebesar ' +
    pct +
    '%. Terdapat ' +
    neg +
    ' butir yang memerlukan tindakan perbaikan prioritas.';

  xml =
    r3ReplaceParagraphByNeedle_(
      xml,
      'Audit Mutu Internal terhadap Agribisnis mencakup',
      summary,
      1
    );

  xml =
    r3ReplaceParagraphByNeedle_(
      xml,
      'Persentase Pemenuhan:',
      'Persentase Pemenuhan: ' +
      pct +
      '%',
      1
    );

  var priorityText =
    neg > 0
      ? (
          'Terdapat ' +
          neg +
          ' butir dengan hasil Belum Mencapai atau Menyimpang. Butir tersebut menjadi prioritas tindakan perbaikan dan harus ditindaklanjuti sesuai rencana perbaikan, jadwal, serta penanggung jawab yang telah ditetapkan.'
        )
      : (
          'Tidak terdapat butir dengan hasil Belum Mencapai atau Menyimpang. Fokus tindak lanjut diarahkan pada pemeliharaan capaian serta rekomendasi peningkatan untuk menjamin keberlanjutan mutu.'
        );

  xml =
    r3ReplaceParagraphByNeedle_(
      xml,
      'Tidak terdapat butir dengan hasil Belum Mencapai',
      priorityText,
      1
    );

  // BAB 1.
  var tujuan =
    r3Clean_(ctx.form2.TujuanAudit) ||
    'Menilai kesesuaian pelaksanaan kegiatan terhadap standar SPMI Universitas Medan Area.';

  xml =
    r3ReplaceParagraphByNeedle_(
      xml,
      'melihat apakah sudah ada review',
      tujuan,
      1
    );

  var groups = [];
  var gs = r3GroupStats_(ctx);

  if (
    gs.PENDIDIKAN.MELAMPAUI +
    gs.PENDIDIKAN.MENCAPAI +
    gs.PENDIDIKAN['BELUM MENCAPAI'] +
    gs.PENDIDIKAN.MENYIMPANG
  ) {
    groups.push('PENDIDIKAN');
  }

  if (
    gs.PENELITIAN.MELAMPAUI +
    gs.PENELITIAN.MENCAPAI +
    gs.PENELITIAN['BELUM MENCAPAI'] +
    gs.PENELITIAN.MENYIMPANG
  ) {
    groups.push('PENELITIAN');
  }

  if (
    gs.PENGABDIAN.MELAMPAUI +
    gs.PENGABDIAN.MENCAPAI +
    gs.PENGABDIAN['BELUM MENCAPAI'] +
    gs.PENGABDIAN.MENYIMPANG
  ) {
    groups.push(
      'PENGABDIAN KEPADA MASYARAKAT'
    );
  }

  if (
    gs.MELAMPAUI.MELAMPAUI +
    gs.MELAMPAUI.MENCAPAI +
    gs.MELAMPAUI['BELUM MENCAPAI'] +
    gs.MELAMPAUI.MENYIMPANG
  ) {
    groups.push('STANDAR MELAMPAUI');
  }

  xml =
    r3ReplaceParagraphByNeedle_(
      xml,
      'Ruang lingkup audit meliputi 1 butir standar',
      'Ruang lingkup audit meliputi ' +
      ctx.assigns.length +
      ' butir standar pada kelompok ' +
      (
        groups.length
          ? groups.join(', ')
          : '-'
      ) +
      '.',
      1
    );

  // BAB 5 Kesimpulan.
  var pos =
    Number(ctx.counts.MELAMPAUI || 0) +
    Number(ctx.counts.MENCAPAI || 0);

  var conclusion1 =
    'Audit Mutu Internal terhadap ' +
    r3Clean_(audit.AuditiName) +
    ' mencakup ' +
    ctx.assigns.length +
    ' butir standar. Sebanyak ' +
    total +
    ' butir telah memperoleh hasil audit, dengan ' +
    pos +
    ' butir pada kategori Mencapai atau Melampaui. Tingkat pemenuhan standar adalah ' +
    pct +
    '%.';

  var conclusion2 =
    neg > 0
      ? (
          'Terdapat ' +
          neg +
          ' butir pada kategori Belum Mencapai atau Menyimpang. Butir tersebut menjadi prioritas tindak lanjut melalui tindakan perbaikan yang terencana, terukur, dan dapat diverifikasi pada proses pengendalian mutu berikutnya.'
        )
      : (
          'Tidak terdapat butir pada kategori Belum Mencapai atau Menyimpang. Fokus tindak lanjut diarahkan pada pemeliharaan hasil yang telah sesuai dan pelaksanaan rekomendasi peningkatan untuk memperkuat keberlanjutan mutu.'
        );

  xml =
    r3ReplaceParagraphByNeedle_(
      xml,
      'dengan 1 butir pada kategori Mencapai atau Melampaui',
      conclusion1,
      1
    );

  xml =
    r3ReplaceParagraphByNeedle_(
      xml,
      'Tidak terdapat butir pada kategori Belum Mencapai',
      conclusion2,
      1
    );

  // Tabel - urutan mengikuti template terbaru.
  var tables = r3TableBlocks_(xml);

  if (tables.length < 13) {
    throw new Error(
      'Template laporan berubah. Ditemukan ' +
      tables.length +
      ' tabel; minimal 13 tabel diperlukan.'
    );
  }

  var patched = {};

  patched[0] =
    r3PatchApprovalInfoTable_(
      tables[0],
      ctx
    );

  patched[1] =
    r3PatchSignatureTable_(
      tables[1],
      ctx
    );

  patched[2] =
    r3PatchTocTable_(
      tables[2],
      ctx
    );

  patched[3] =
    r3PatchKpiTable_(
      tables[3],
      ctx
    );

  patched[4] =
    r3PatchGroupTable_(
      tables[4],
      ctx
    );

  patched[5] =
    r3PatchTeamTable_(
      tables[5],
      ctx
    );

  patched[6] =
    r3PatchVisitTable_(
      tables[6],
      ctx
    );

  patched[7] =
    r3PatchResultTable_(
      tables[7],
      ctx
    );

  patched[8] =
    r3PatchPriorityTables_(
      tables[8],
      ctx
    );

  patched[9] =
    r3PatchImprovementTable_(
      tables[9],
      ctx
    );

  patched[10] =
    r3PatchNotesTable_(
      tables[10],
      ctx
    );

  patched[11] =
    r3PatchEvidenceTable_(
      tables[11],
      ctx
    );

  patched[12] =
    r3PatchProgramTable_(
      tables[12],
      ctx
    );

  // Replace tables from the end so indexes before them stay stable.
  for (var ti = 12; ti >= 0; ti--) {
    xml =
      r3ReplaceTableIndex_(
        xml,
        ti,
        patched[ti]
      );
  }

  // V18: rapikan spacer kosong bawaan template setelah tabel dinamis.
  // Page break/section break tidak dihapus sehingga orientasi dan pemisahan
  // antar BAB/Lampiran tetap mengikuti template resmi.
  xml = r3CompactSpacerBeforeHeading_(xml, 'BAB 4 REKOMENDASI PENINGKATAN');
  xml = r3CompactSpacerBeforeHeading_(xml, 'BAB 5');
  xml = r3CompactSpacerBeforeHeading_(xml, 'LAMPIRAN 2 DAFTAR BUKTI PENDUKUNG');
  xml = r3CompactSpacerBeforeHeading_(xml, 'LAMPIRAN 3');

  map['word/document.xml'] =
    Utilities.newBlob(
      xml,
      'application/xml',
      'word/document.xml'
    );

  // Replace chart images but keep the template's exact size/position.
  try {
    map['word/media/image3.png'] =
      Utilities.newBlob(
        r3PieChart_(ctx).getBytes(),
        'image/png',
        'word/media/image3.png'
      );
  } catch (ignoreChart1) {}

  try {
    map['word/media/image4.png'] =
      Utilities.newBlob(
        r3BarChart_(ctx).getBytes(),
        'image/png',
        'word/media/image4.png'
      );
  } catch (ignoreChart2) {}

  map = r3PatchPageNumberFooter_(map);

  var out = [];

  Object.keys(map).forEach(function(name) {
    var b = map[name];

    out.push(
      Utilities.newBlob(
        b.getBytes(),
        b.getContentType(),
        name
      )
    );
  });

  var zipped =
    Utilities.zip(
      out,
      'AMI_Report_V3.zip'
    );

  return Utilities.newBlob(
    zipped.getBytes(),
    R3_DOCX_MIME_,
    'Laporan_AMI_V31.docx'
  );
}

/* ============================ DRIVE ============================ */

function r3ReportFolder_() {
  var props=PropertiesService.getScriptProperties();
  var id=r3Clean_(props.getProperty('AMI_REPORT_FOLDER_ID'));
  if(id){try{return DriveApp.getFolderById(id);}catch(ignoreInvalid){}}

  // V27: mencegah dua request preview/final pertama membuat folder laporan ganda.
  // Lock hanya dipakai saat folder belum pernah diinisialisasi.
  var lock=LockService.getScriptLock();
  if(!lock.tryLock(30000))throw new Error('Folder laporan sedang disiapkan oleh proses lain. Tunggu beberapa detik lalu coba kembali.');
  try{
    id=r3Clean_(props.getProperty('AMI_REPORT_FOLDER_ID'));
    if(id){try{return DriveApp.getFolderById(id);}catch(ignoreStale){props.deleteProperty('AMI_REPORT_FOLDER_ID');}}
    var name='AMI 2026 - Laporan Final';
    var it=DriveApp.getFoldersByName(name);
    var folder=it.hasNext()?it.next():DriveApp.createFolder(name);
    props.setProperty('AMI_REPORT_FOLDER_ID',folder.getId());
    return folder;
  }finally{try{lock.releaseLock();}catch(ignoreRelease){}}
}

function r3Bytes_(s) {
  return Utilities
    .newBlob(
      String(s),
      'text/plain'
    )
    .getBytes();
}

function r3ConcatBytes_(arrays) {
  var out = [];

  arrays.forEach(function(a) {
    for (var i = 0; i < a.length; i++) {
      out.push(a[i]);
    }
  });

  return out;
}

function r3ImportDocxAsGoogleDoc_(
  docxBlob,
  name,
  folder
) {
  var boundary =
    'AMI_V3_' +
    Utilities
      .getUuid()
      .replace(/-/g, '');

  var metadata = {
    name:name,
    mimeType:
      'application/vnd.google-apps.document',
    parents:[folder.getId()]
  };

  var h1 =
    '--' +
    boundary +
    '\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n' +
    JSON.stringify(metadata) +
    '\r\n';

  var h2 =
    '--' +
    boundary +
    '\r\nContent-Type: ' +
    R3_DOCX_MIME_ +
    '\r\n\r\n';

  var tail =
    '\r\n--' +
    boundary +
    '--';

  var payload =
    r3ConcatBytes_([
      r3Bytes_(h1),
      r3Bytes_(h2),
      docxBlob.getBytes(),
      r3Bytes_(tail)
    ]);

  var res =
    UrlFetchApp.fetch(
      'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&fields=id,name',
      {
        method:'post',
        contentType:
          'multipart/related; boundary=' +
          boundary,
        payload:payload,
        headers:{
          Authorization:
            'Bearer ' +
            ScriptApp.getOAuthToken()
        },
        muteHttpExceptions:true
      }
    );

  if (
    res.getResponseCode() < 200 ||
    res.getResponseCode() >= 300
  ) {
    throw new Error(
      'Gagal mengonversi template Word ke Google Docs: HTTP ' +
      res.getResponseCode() +
      ' ' +
      res.getContentText()
    );
  }

  var data =
    JSON.parse(
      res.getContentText()
    );

  return DriveApp.getFileById(data.id);
}

function r3PdfFromDocx_(
  docxBlob,
  name,
  folder,
  keepGoogleDoc
) {
  var googleFile =
    r3ImportDocxAsGoogleDoc_(
      docxBlob,
      name,
      folder
    );

  Utilities.sleep(1200);

  var pdf =
    googleFile
      .getAs(MimeType.PDF)
      .setName(name + '.pdf');

  if (!keepGoogleDoc) {
    try {
      googleFile.setTrashed(true);
    } catch (ignore) {}
  }

  return {
    googleFile:googleFile,
    pdfBlob:pdf
  };
}

/* ============================ REPORT LOG ============================ */

function r3Hash_(ctx) {
  // Hash laporan mengikuti hash data audit resmi agar perubahan pada Evaluasi Diri,
  // bukti, tindak lanjut, hasil positif, Form 2/3, visitasi, atau tim terdeteksi.
  var coreHash = typeof approvalHash_ === 'function'
    ? approvalHash_(r3Clean_(ctx.audit.AuditID))
    : JSON.stringify({audit:r3Clean_(ctx.audit.AuditID),counts:ctx.counts});
  var raw=JSON.stringify({engine:'TEMPLATE_V40_V21_COVER_XML_SAFE',audit:r3Clean_(ctx.audit.AuditID),coreHash:coreHash});
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,raw,Utilities.Charset.UTF_8).map(function(b){
    var v=b<0?b+256:b;return('0'+v.toString(16)).slice(-2);
  }).join('');
}

/* ============================ PUBLIC ============================ */


function diagnoseAmiReport(token, auditId) {
  var u = session_(token);
  var ctx = r3Context_(auditId);

  if (!r3CanAccess_(u, ctx.audit)) {
    throw new Error('Anda tidak memiliki akses ke audit ini.');
  }

  var readiness = r31FinalReadiness_(ctx);

  var rows = ctx.assigns.map(function(a) {
    var e = r3Entry_(ctx, a);

    return {
      AssignID:r3Clean_(a.AssignID),
      ItemCode:r3Clean_(a.ItemCode),
      NamaStandar:r3Clean_(a.NamaStandar),
      NoPernyataan:r3StatementNo_(e),
      Kategori:r31EntryCategory_(e) || 'BELUM DINILAI',
      Deskripsi:r3Clean_(e.finding.Deskripsi),
      Rekomendasi:r3Clean_(e.finding.Rekomendasi),
      FaktorPendukung:r3Clean_(e.improvement.FaktorPendukung),
      RekomendasiPeningkatanIndikator:
        r3Clean_(
          e.improvement.RekomendasiPeningkatanIndikator
        ),
      EvidenceCount:e.evidence.length
    };
  });

  return serializeValue_({
    ok:readiness.ok,
    errors:readiness.errors,
    warnings:readiness.warnings,
    audit:{
      AuditID:r3Clean_(ctx.audit.AuditID),
      AuditiName:r3Clean_(ctx.audit.AuditiName),
      Status:r3Clean_(ctx.audit.Status)
    },
    assignedCount:ctx.assigns.length,
    counts:ctx.counts,
    sectionData:{
      bab2Rows:ctx.assigns.length,
      bab3NegativeRows:r3NegativeEntries_(ctx).length,
      bab4PositiveRows:r3PositiveEntries_(ctx).length,
      auditorNotes:r3AuditNotes_(ctx.form3).filter(function(x){return r3Clean_(x && x.catatan);}).length,
      evidenceRows:r3EvidenceList_(ctx).length,
      programSteps:r3ProgramSteps_(ctx.form2).filter(function(x){return r3Clean_(x && x.step && x.step.uraian);}).length,
      hasProgramObjective:r3ProgramForms_(ctx.form2).some(function(x){return !!r3Clean_(x&&x.tentatifAuditObjektif);}),
      hasAuditPurpose:r3ProgramForms_(ctx.form2).some(function(x){return !!r3Clean_(x&&x.tujuanAudit);})
    },
    results:rows,
    templateSha256:R31_TEMPLATE_SHA256_,
    engine:R31_ENGINE_VERSION_
  });
}

function getAmiReportPreview(
  token,
  auditId
) {
  var u = session_(token);
  var ctx = r3Context_(auditId);

  if (!r3CanAccess_(u, ctx.audit)) {
    throw new Error(
      'Anda tidak memiliki akses ke laporan audit ini.'
    );
  }

  var blob =
    r3PatchDocument_(ctx);

  var folder =
    r3ReportFolder_();

  var name =
    'Preview_AMI_' +
    String(
      ctx.audit.AuditiName ||
      'Auditi'
    ).replace(
      /[^A-Za-z0-9_-]+/g,
      '_'
    ) +
    '_' +
    Utilities.formatDate(
      new Date(),
      R3_TZ_,
      'yyyyMMdd_HHmmss'
    );

  var result =
    r3PdfFromDocx_(
      blob,
      name,
      folder,
      false
    );

  var bytes =
    result.pdfBlob.getBytes();

  return serializeValue_({
    ok:true,
    filename:name + '.pdf',
    mime:'application/pdf',
    base64:
      Utilities.base64Encode(bytes)
  });
}

function r3ReusableReport_(auditId,validationHash) {
  var same = r3Rows_('REPORT_LOG', auditId)
    .filter(function(r) {
      return r3Clean_(r.Status) === 'FINAL' &&
        r3Clean_(r.ValidationHash) === r3Clean_(validationHash);
    })
    .sort(function(a,b) {
      return (Number(b.Version)||0) - (Number(a.Version)||0);
    });

  for (var i=0; i<same.length; i++) {
    try {
      var x=same[i];
      if (!r3Clean_(x.DocxFileID) || !r3Clean_(x.PdfFileID)) continue;
      DriveApp.getFileById(x.DocxFileID).getName();
      DriveApp.getFileById(x.PdfFileID).getName();
      return x;
    } catch (ignore) {}
  }
  return null;
}

function r3TrashFileSafe_(fileOrId) {
  try {
    if (!fileOrId) return;
    if (typeof fileOrId === 'string') DriveApp.getFileById(fileOrId).setTrashed(true);
    else if (typeof fileOrId.setTrashed === 'function') fileOrId.setTrashed(true);
  } catch (ignore) {}
}

function generateAmiFinalReport(
  token,
  auditId
) {
  // Pembuatan DOCX/PDF sengaja dilakukan di luar ScriptLock. Konversi Word->Google
  // Docs dapat memakan beberapa detik dan tidak boleh memblokir penyimpanan audit lain.
  var u = requireRole_(token,['ADMIN_BPM']);
  var ctx = r3Context_(auditId);

  if (r3Clean_(ctx.audit.Status) !== 'FINAL') {
    throw new Error('Laporan final hanya dapat dibuat setelah audit berstatus FINAL.');
  }

  var readiness = r31FinalReadiness_(ctx);
  if (!readiness.ok) {
    throw new Error(
      'Laporan belum dapat dibuat karena data sistem belum lengkap: ' +
      readiness.errors.join(' ')
    );
  }

  var validationHash = r3Hash_(ctx);
  var reusable = r3ReusableReport_(auditId,validationHash);
  if (reusable) {
    return serializeValue_({
      ok:true,
      reportId:reusable.ReportID,
      version:reusable.Version,
      reused:true,
      message:'Laporan resmi dengan data yang sama sudah tersedia dan digunakan kembali.'
    });
  }

  var folder = r3ReportFolder_();
  var base =
    'Laporan_AMI_2026_' +
    String(ctx.audit.AuditiName || 'Auditi').replace(/[^A-Za-z0-9_-]+/g,'_') +
    '_' + Utilities.formatDate(new Date(),R3_TZ_,'yyyyMMdd_HHmmss');

  var docxFile=null,converted=null,pdfFile=null,reportRecorded=false;

  try {
    var docxBlob = r3PatchDocument_(ctx).setName(base + '.docx');
    docxFile = folder.createFile(docxBlob);
    converted = r3PdfFromDocx_(docxBlob,base,folder,true);
    pdfFile = folder.createFile(converted.pdfBlob.setName(base + '.pdf'));

    return withLock_(function() {
      // Data mungkin berubah oleh eksekusi Apps Script lain selama konversi. Buang
      // cache lokal eksekusi ini sebelum double-check di dalam lock.
      invalidateRowsCache_('REPORT_LOG');
      invalidateRowsCache_('AMI_AUDITI');
      // Double-check sesudah konversi. Jika request paralel sudah lebih dulu mencatat
      // hash yang sama, file request kedua dibuang dan laporan pertama digunakan.
      var currentAudit=findOne_('AMI_AUDITI','AuditID',auditId);
      if(!currentAudit || r3Clean_(currentAudit.Status)!=='FINAL') {
        throw new Error('Status audit berubah sebelum laporan selesai dicatat.');
      }

      var concurrent = r3ReusableReport_(auditId,validationHash);
      if (concurrent) {
        r3TrashFileSafe_(docxFile);
        r3TrashFileSafe_(pdfFile);
        if(converted&&converted.googleFile)r3TrashFileSafe_(converted.googleFile);
        return serializeValue_({
          ok:true,
          reportId:concurrent.ReportID,
          version:concurrent.Version,
          reused:true,
          message:'Laporan resmi dengan data yang sama sudah tersedia dan digunakan kembali.'
        });
      }

      var old=r3Rows_('REPORT_LOG',auditId),maxVersion=0,archivePatches=[];
      old.forEach(function(r){
        maxVersion=Math.max(maxVersion,Number(r.Version)||0);
        if(r3Clean_(r.Status)==='FINAL') {
          archivePatches.push({ReportID:r.ReportID,Status:'ARSIP'});
        }
      });
      if(archivePatches.length)batchUpsert_('REPORT_LOG',['ReportID'],archivePatches,[]);

      var rec={
        ReportID:uuid_('RPT'),
        AuditID:auditId,
        Version:maxVersion+1,
        Status:'FINAL',
        GoogleDocID:converted.googleFile.getId(),
        DocxFileID:docxFile.getId(),
        PdfFileID:pdfFile.getId(),
        ValidationHash:validationHash,
        DocxBytes:docxFile.getSize(),
        PdfBytes:pdfFile.getSize(),
        CreatedAt:r3Now_(),
        CreatedBy:u.Nama
      };
      appendObject_('REPORT_LOG',rec);
      reportRecorded=true;

      if(typeof auditLog_==='function') {
        try{auditLog_(u,'GENERATE_AMI_REPORT_FINAL','REPORT_LOG',auditId,rec.ReportID,'',rec);}catch(ignoreLog){}
      }

      return serializeValue_({
        ok:true,
        reportId:rec.ReportID,
        version:rec.Version,
        reused:false,
        message:'Laporan resmi AMI berhasil dibuat. BAB IV menggunakan Faktor Pendukung dan Rekomendasi Peningkatan Indikator hasil Auditor.'
      });
    });
  } catch (e) {
    // Bila konversi gagal sebelum REPORT_LOG tersimpan, jangan tinggalkan file yatim.
    // File yang sudah berhasil dicatat tidak akan masuk jalur ini karena return selesai.
    // Bila REPORT_LOG sudah tersimpan, file adalah sumber resmi dan tidak boleh
    // ditrash hanya karena metadata sekunder/response mengalami error.
    if(!reportRecorded){
      r3TrashFileSafe_(docxFile);
      r3TrashFileSafe_(pdfFile);
      if(converted&&converted.googleFile)r3TrashFileSafe_(converted.googleFile);
    }
    throw e;
  }
}

function listReports(token) {
  var u=session_(token);
  var audits=getAllRows_('AMI_AUDITI');
  if(typeof filterAuditsForUser_==='function') audits=filterAuditsForUser_(u,audits);
  else if(r3Clean_(u.Role)!=='ADMIN_BPM') audits=[];
  var allowed={};audits.forEach(function(a){allowed[r3Clean_(a.AuditID)]=a;});
  return serializeValue_(getAllRows_('REPORT_LOG').filter(function(r){
    return !!allowed[r3Clean_(r.AuditID)];
  }).map(function(r){
    var a=allowed[r3Clean_(r.AuditID)]||{},o=cleanRow_(r);
    o.AuditiName=r3Clean_(a.AuditiName);o.Jenjang=r3Clean_(a.Jenjang);
    // Hindari satu Drive API call per laporan. Timestamp resmi sudah tersimpan di REPORT_LOG.
    o.CreatedAtDisplay=r3DateTimeId_(r.CreatedAt);
    return o;
  }).sort(function(a,b){return String(b.CreatedAt||'').localeCompare(String(a.CreatedAt||''));}));
}

function downloadReportFile(token,reportId,format){
  var u=session_(token),r=findOne_('REPORT_LOG','ReportID',reportId);if(!r)throw new Error('Laporan tidak ditemukan.');
  var audit=findOne_('AMI_AUDITI','AuditID',r.AuditID);if(!audit||!r3CanAccess_(u,audit))throw new Error('Anda tidak memiliki akses ke laporan ini.');
  format=r3Clean_(format).toUpperCase();
  var fileId=format==='PDF'?r3Clean_(r.PdfFileID):r3Clean_(r.DocxFileID);
  if(format!=='PDF'&&format!=='DOCX')throw new Error('Format laporan harus PDF atau DOCX.');
  if(!fileId)throw new Error('File '+format+' belum tersedia.');
  try{
    var file=DriveApp.getFileById(fileId),blob=file.getBlob();
    return {ok:true,fileName:file.getName(),mimeType:blob.getContentType(),base64:Utilities.base64Encode(blob.getBytes())};
  }catch(e){
    if(typeof logSystemError_==='function')logSystemError_('downloadReportFile',e,u,{reportId:reportId,format:format});
    throw new Error('File laporan tidak dapat dibuka dari Google Drive.');
  }
}
