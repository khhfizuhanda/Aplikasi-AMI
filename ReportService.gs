function r3PatchResultTable_(tbl, ctx) {
  var rows = r3RowBlocks_(tbl);

  if (rows.length < 14) {
    throw new Error(
      'Template BAB 2 berubah: struktur tabel Hasil Temuan tidak sesuai.'
    );
  }

  var header = rows[0];
  var dataTemplate = rows[1];

  var summaryRows = rows.slice(8, 14);

  var resultData = ctx.assigns.slice();

  if (!resultData.length) {
    resultData = [{
      _reportEmpty:true,
      ItemCode:'',
      NamaStandar:'BELUM ADA HASIL AUDIT'
    }];
  }

  var dataRows =
    r3BuildSimpleRows_(
      dataTemplate,
      1,
      resultData,
      function(row, a, i) {
        var e =
          a._reportEmpty
            ? {
                master:{},
                self:{},
                desk:{},
                finding:{},
                evidence:[]
              }
            : r3Entry_(ctx, a);

        row =
          r3SetRowCellText_(
            row,
            0,
            String(i + 1)
          );

        row =
          r3SetRowCellText_(
            row,
            1,
            r3Clean_(a.NamaStandar) ||
            r3Clean_(a.ItemCode) ||
            '-'
          );

        row =
          r3SetRowCellText_(
            row,
            2,
            a._reportEmpty
              ? ''
              : r3StatementNo_(e)
          );

        row =
          r3SetRowCellText_(
            row,
            3,
            a._reportEmpty
              ? ''
              : (
                  r3Clean_(a.IndikatorSnapshot) ||
                  r3Clean_(e.master.Indikator) ||
                  '-'
                )
          );

        var desc =
          a._reportEmpty
            ? ''
            : (
                r3Clean_(e.finding.Deskripsi) ||
                r3Clean_(e.desk.CatatanDesk) ||
                r3Clean_(e.self.EvaluasiDiri) ||
                '-'
              );

        row =
          r3SetRowCellText_(
            row,
            4,
            desc
          );

        var cat =
          a._reportEmpty
            ? ''
            : (
                r31EntryCategory_(e) ||
                'BELUM DINILAI'
              );

        row =
          r3SetRowCellText_(
            row,
            5,
            cat
          );

        row =
          r3SetRowCellColor_(
            row,
            5,
            (
              cat === 'BELUM MENCAPAI' ||
              cat === 'MENYIMPANG'
            )
              ? 'FF0000'
              : '000000'
          );

        return row;
      }
    );

  var total = ctx.counts;
  var group = r3GroupStats_(ctx);

  // Total count row.
  summaryRows[1] =
    r3SetRowCellText_(
      summaryRows[1],
      1,
      String(total.MELAMPAUI || 0)
    );

  summaryRows[1] =
    r3SetRowCellText_(
      summaryRows[1],
      2,
      String(total.MENCAPAI || 0)
    );

  summaryRows[1] =
    r3SetRowCellText_(
      summaryRows[1],
      3,
      String(total['BELUM MENCAPAI'] || 0)
    );

  summaryRows[1] =
    r3SetRowCellText_(
      summaryRows[1],
      4,
      String(total.MENYIMPANG || 0)
    );

  var order = [
    'PENDIDIKAN',
    'PENELITIAN',
    'PENGABDIAN',
    'MELAMPAUI'
  ];

  for (var g = 0; g < order.length; g++) {
    var sr = g + 2;
    var s = group[order[g]];

    summaryRows[sr] =
      r3SetRowCellText_(
        summaryRows[sr],
        1,
        String(s.MELAMPAUI || 0)
      );

    summaryRows[sr] =
      r3SetRowCellText_(
        summaryRows[sr],
        2,
        String(s.MENCAPAI || 0)
      );

    summaryRows[sr] =
      r3SetRowCellText_(
        summaryRows[sr],
        3,
        String(s['BELUM MENCAPAI'] || 0)
      );

    summaryRows[sr] =
      r3SetRowCellText_(
        summaryRows[sr],
        4,
        String(s.MENYIMPANG || 0)
      );
  }

  return r3RebuildTable_(
    tbl,
    [header]
      .concat(dataRows)
      .concat(summaryRows)
  );
}

function r3NegativeEntries_(ctx) {
  return ctx.assigns.map(function(a) {
    return r3Entry_(ctx, a);
  }).filter(function(e) {
    return [
      'BELUM MENCAPAI',
      'MENYIMPANG'
    ].indexOf(
      r31EntryCategory_(e)
    ) >= 0;
  });
}

function r3PositiveEntries_(ctx) {
  return ctx.assigns.map(function(a) {
    return r3Entry_(ctx, a);
  }).filter(function(e) {
    return [
      'MENCAPAI',
      'MELAMPAUI'
    ].indexOf(
      r31EntryCategory_(e)
    ) >= 0;
  });
}

function r3FillPriorityTable_(tbl, e) {
  var rows = r3RowBlocks_(tbl);

  var vals = [
    r3Clean_(e.assign.ItemCode) || '-',
    r3Clean_(e.assign.NamaStandar) || '-',
    r3Clean_(e.assign.PernyataanStandarSnapshot) ||
      r3Clean_(e.master.PernyataanStandar) ||
      '-',
    r3Clean_(e.assign.IndikatorSnapshot) ||
      r3Clean_(e.master.Indikator) ||
      '-',
    r31EntryCategory_(e) || '-',
    r3Clean_(e.finding.Deskripsi) || '-',
    r3Clean_(e.finding.Akibat) || '-',
    r3Clean_(e.finding.AkarPenyebab) || '-',
    r3Clean_(e.finding.Rekomendasi) || '-',
    r3Clean_(e.finding.TanggapanAuditi) || '-',
    r3Clean_(e.finding.RencanaPerbaikan) || '-',
    r3FindingDate_(
      e.finding,
      'JadwalPerbaikan'
    ),
    r3Clean_(e.finding.PJPerbaikan) || '-'
  ];

  for (var i = 0; i < vals.length && i < rows.length; i++) {
    rows[i] =
      r3SetRowCellText_(
        rows[i],
        1,
        vals[i]
      );
  }

  // V14: Rencana Pencegahan bersifat opsional pada Evaluasi Diri/hasil audit.
  // Jika salah satu isian pencegahan tersedia, cetak ketiganya pada BAB 3
  // setelah Penanggung Jawab Perbaikan. Jika seluruhnya kosong, tabel tetap
  // seperti template lama tanpa menambah baris kosong.
  var preventionRaw = [
    e.finding.RencanaPencegahan,
    e.finding.JadwalPencegahan,
    e.finding.PJPencegahan
  ];
  var hasPrevention = preventionRaw.some(function(v) {
    return !!r3Clean_(v);
  });

  if (hasPrevention && rows.length) {
    var preventionTemplate = rows[rows.length - 1];
    var preventionRows = [
      [
        'Rencana Pencegahan',
        r3Clean_(e.finding.RencanaPencegahan) || '-'
      ],
      [
        'Jadwal Pencegahan',
        r3FindingDate_(e.finding, 'JadwalPencegahan')
      ],
      [
        'Penanggung Jawab Pencegahan',
        r3Clean_(e.finding.PJPencegahan) || '-'
      ]
    ];

    preventionRows.forEach(function(item) {
      var row = preventionTemplate;
      row = r3SetRowCellText_(row, 0, item[0]);
      row = r3SetRowCellText_(row, 1, item[1]);
      rows.push(row);
    });
  }

  return r3RebuildTable_(tbl, rows);
}

function r3PatchPriorityTables_(tbl, ctx) {
  var items = r3NegativeEntries_(ctx);

  if (!items.length) {
    var rows = r3RowBlocks_(tbl);

    for (var i = 0; i < rows.length; i++) {
      rows[i] =
        r3SetRowCellText_(
          rows[i],
          1,
          i === 4
            ? 'TIDAK ADA TEMUAN PRIORITAS'
            : ''
        );
    }

    return r3RebuildTable_(tbl, rows);
  }

  var blocks = [];

  for (var j = 0; j < items.length; j++) {
    if (j) blocks.push(r3PageBreakParagraph_());

    blocks.push(
      r3FillPriorityTable_(
        tbl,
        items[j]
      )
    );
  }

  return blocks.join('');
}

function r3PatchImprovementTable_(tbl, ctx) {
  var rows = r3RowBlocks_(tbl);

  if (rows.length < 2) return tbl;

  var header = rows[0];
  var base = rows[1];
  var items = r3PositiveEntries_(ctx);

  var improvementItems = items.slice();

  if (!improvementItems.length) {
    improvementItems = [{
      _reportEmpty:true,
      assign:{
        NamaStandar:'TIDAK ADA REKOMENDASI PENINGKATAN',
        ItemCode:''
      },
      master:{},
      finding:{},
      improvement:{}
    }];
  }

  var dataRows =
    r3BuildSimpleRows_(
      base,
      1,
      improvementItems,
      function(row, e, i) {
        // 1. No
        row =
          r3SetRowCellText_(
            row,
            0,
            e._reportEmpty
              ? ''
              : String(i + 1)
          );

        // 2. Nama Standar
        row =
          r3SetRowCellText_(
            row,
            1,
            r3Clean_(e.assign.NamaStandar) ||
            r3Clean_(e.assign.ItemCode) ||
            '-'
          );

        // 3. No. Pernyataan
        row =
          r3SetRowCellText_(
            row,
            2,
            e._reportEmpty
              ? ''
              : r3StatementNo_(e)
          );

        // 4. Faktor Pendukung
        row =
          r3SetRowCellText_(
            row,
            3,
            e._reportEmpty
              ? ''
              : (
                  r3Clean_(
                    e.improvement.FaktorPendukung
                  ) ||
                  '-'
                )
          );

        // 5. Indikator
        row =
          r3SetRowCellText_(
            row,
            4,
            e._reportEmpty
              ? ''
              : (
                  r3Clean_(e.assign.IndikatorSnapshot) ||
                  r3Clean_(e.master.Indikator) ||
                  '-'
                )
          );

        // 6. Rekomendasi Peningkatan Indikator
        row =
          r3SetRowCellText_(
            row,
            5,
            e._reportEmpty
              ? ''
              : (
                  r3Clean_(
                    e.improvement
                      .RekomendasiPeningkatanIndikator
                  ) ||
                  r3Clean_(e.finding.Rekomendasi) ||
                  (
                    r31EntryCategory_(e) === 'MELAMPAUI'
                      ? 'Pertahankan praktik baik dan tingkatkan capaian indikator secara berkelanjutan.'
                      : 'Pertahankan pemenuhan dan lakukan peningkatan indikator secara berkelanjutan.'
                  )
                )
          );

        return row;
      }
    );

  return r3RebuildTable_(
    tbl,
    [header].concat(dataRows)
  );
}

