function r3PatchProgramTable_(tbl, ctx) {
  var rows = r3RowBlocks_(tbl);
  if (rows.length < 13) {
    throw new Error('Template Lampiran Program Kerja berubah.');
  }

  var templatePrefix = rows.slice(0, 8);
  var base = rows[8];
  var programs = r3ProgramForms_(ctx.form2);

  var fallbackCode = ctx.assigns.length
    ? (
        ctx.assigns.length === 1
          ? r3Clean_(ctx.assigns[0].ItemCode)
          : ('Sesuai BAB 2 (' + ctx.assigns.length + ' butir)')
      )
    : '-';

  var fallbackName = ctx.assigns.length
    ? (
        ctx.assigns.length === 1
          ? r3Clean_(ctx.assigns[0].NamaStandar)
          : ('Ruang Lingkup AMI ' + r3Clean_(ctx.audit.AuditiName))
      )
    : '-';

  if (!programs.length) {
    programs = [{
      _reportEmpty:true,
      nomorStandar:fallbackCode,
      namaStandar:fallbackName,
      tentatifAuditObjektif:'Belum ada Program Kerja Audit pada sistem.',
      tujuanAudit:'-',
      langkahKerja:[]
    }];
  }

  var programTables = [];

  programs.forEach(function(p, pi) {
    p = p || {};

    var nomorStandar =
      r3Clean_(p.nomorStandar) ||
      fallbackCode ||
      '-';

    var namaStandar =
      r3Clean_(p.namaStandar) ||
      fallbackName ||
      '-';

    var prefix = templatePrefix.slice();

    prefix[0] = r3SetRowCellText_(
      prefix[0],
      0,
      (p._reportEmpty ? '' : 'Program Kerja Audit #' + String(pi + 1) + ' — ') +
      'Nomor Standar: ' + nomorStandar
    );

    prefix[0] = r3SetRowCellText_(
      prefix[0],
      1,
      'Nama Standar: ' + namaStandar
    );

    prefix[2] = r3SetRowCellText_(
      prefix[2],
      0,
      r3Clean_(p.tentatifAuditObjektif) || '-'
    );

    prefix[4] = r3SetRowCellText_(
      prefix[4],
      0,
      r3Clean_(p.tujuanAudit) || '-'
    );

    var steps = Array.isArray(p.langkahKerja)
      ? p.langkahKerja.filter(function(x) {
          x = x || {};
          return r3Clean_(x.uraian) ||
            r3Clean_(x.estimasi) ||
            r3Clean_(x.noPernyataan) ||
            r3Clean_(x.realisasi) ||
            r3Clean_(x.inisialAuditor);
        })
      : [];

    if (!steps.length) {
      steps = [{
        _reportEmpty:true,
        uraian:'Belum ada uraian langkah kerja pada program ini.',
        estimasi:'',
        realisasi:'',
        noPernyataan:'',
        inisialAuditor:''
      }];
    }

    // Tidak lagi memaksa 5 baris. Jumlah baris langkah kerja mengikuti
    // data aktual: 2 langkah = 2 baris, 5 langkah = 5 baris, dst.
    var stepRows = r3BuildSimpleRows_(
      base,
      1,
      steps,
      function(row, x, i) {
        row = r3SetRowCellText_(row, 0, x._reportEmpty ? '' : String(i + 1));
        row = r3SetRowCellText_(row, 1, r3Clean_(x.uraian) || '-');
        row = r3SetRowCellText_(row, 2, r3Clean_(x.estimasi) || '-');
        row = r3SetRowCellText_(row, 3, r3Clean_(x.realisasi) || '-');
        row = r3SetRowCellText_(row, 4, r3Clean_(x.noPernyataan) || '-');
        row = r3SetRowCellText_(row, 5, r3Clean_(x.inisialAuditor) || '-');
        return row;
      }
    );

    // Satu Program Kerja = satu tabel mandiri.
    // Dengan begitu page break dapat dipasang antar-program dan tabel tidak
    // menempel/terpotong bersama program berikutnya.
    programTables.push(
      r3RebuildTable_(
        tbl,
        prefix.concat(stepRows)
      )
    );
  });

  return programTables.join(r3PageBreakParagraph_());
}

