/**
 * ReportService.gs — mesin tunggal laporan resmi AMI 2026
 * Generator laporan AMI berbasis TEMPLATE WORD RESMI.
 *
 * Prinsip:
 * - Template biner berasal dari "Bentuk laporan AMI 2026.docx".
 * - Tidak membangun ulang cover/margin/section/font dengan DocumentApp.
 * - Mengedit XML DOCX di tempat agar layout Word tetap mengikuti template.
 * - BAB 2, BAB 3, BAB 4 tetap landscape sesuai template.
 * - Bagian lain tetap portrait sesuai template.
 * - Grafik template diganti dengan grafik aktual tanpa mengubah ukuran/posisinya.
 * - Footer nomor halaman ditambahkan; cover tidak menampilkan nomor.
 *
 * Tidak mengubah database dan tidak memerlukan setupDatabase().
 */

var R3_TZ_ = 'Asia/Jakarta';
var R31_ENGINE_VERSION_ = '4.0-v21-cover-xml-safe';
var R31_TEMPLATE_SHA256_ = 'eb72a4d5964d914b854fa1a269143d4dbfd0dce6560e558c83249b8166e8d4bc';
var R3_TEMPLATE_B64_ = '';
var R3_DOCX_MIME_ = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';

/* ============================ UTIL ============================ */

function r3Clean_(v) {
  return cleanText_(v);
}

function r3Now_() {
  return Utilities.formatDate(new Date(), R3_TZ_, "yyyy-MM-dd'T'HH:mm:ss");
}

function r3XmlEscape_(s) {
  return String(s == null ? '' : s)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&apos;');
}

function r3XmlUnescape_(s) {
  return String(s == null ? '' : s)
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&amp;/g, '&');
}

function r3StripXml_(xml) {
  return r3XmlUnescape_(
    String(xml || '')
      .replace(/<w:tab\/>/g, '\t')
      .replace(/<w:br\/>/g, '\n')
      .replace(/<[^>]+>/g, '')
  );
}

function r3TextXml_(text) {
  var parts = String(text == null ? '' : text).split(/\r?\n/);
  var out = [];

  for (var i = 0; i < parts.length; i++) {
    if (i) out.push('<w:br/>');
    out.push(
      '<w:t xml:space="preserve">' +
      r3XmlEscape_(parts[i]) +
      '</w:t>'
    );
  }

  return out.join('');
}

function r3InsertedRunPr_(paragraphXml) {
  // Sel kosong pada template resmi sering hanya memiliki w:rPr di w:pPr,
  // tanpa w:r/w:t. Ambil font/ukuran dari paragraph mark agar layout asli
  // tetap dipertahankan, tetapi netralkan warna/bold placeholder lama.
  var m = paragraphXml.match(/<w:pPr\b[\s\S]*?(<w:rPr>[\s\S]*?<\/w:rPr>)[\s\S]*?<\/w:pPr>/);
  var rp = m ? m[1] : '';

  if (!rp) {
    rp = '<w:rPr><w:rFonts w:ascii="Arial" w:hAnsi="Arial" w:cs="Arial"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr>';
  }

  rp = rp
    .replace(/<w:b\b[^>]*\/>/g, '')
    .replace(/<w:bCs\b[^>]*\/>/g, '')
    .replace(/<w:color\b[^>]*\/>/g, '');

  return rp.replace(
    '</w:rPr>',
    '<w:color w:val="000000"/></w:rPr>'
  );
}

function r3ReplaceContainerText_(containerXml, text) {
  var re = /<w:t\b[^>]*>[\s\S]*?<\/w:t>/g;
  var matches = [];
  var m;

  while ((m = re.exec(containerXml)) !== null) {
    matches.push({start:m.index, end:re.lastIndex});
  }

  if (!matches.length) {
    // BUGFIX laporan 2026: banyak sel data di template memang kosong total
    // (tidak memiliki w:t). Versi lama hanya dapat mengganti w:t yang sudah
    // ada sehingga BAB 2, BAB 3, BAB 4, Catatan Auditor, dan Langkah Kerja
    // tetap kosong walaupun data aplikasi tersedia.
    var pRe = /<w:p\b[^>]*>[\s\S]*?<\/w:p>/g;
    var pm = pRe.exec(containerXml);

    if (pm) {
      var paragraph = pm[0];
      var close = paragraph.lastIndexOf('</w:p>');

      if (close >= 0) {
        var run = '<w:r>' +
          r3InsertedRunPr_(paragraph) +
          r3TextXml_(text) +
          '</w:r>';
        var patchedParagraph = paragraph.substring(0, close) + run + paragraph.substring(close);
        return containerXml.substring(0, pm.index) + patchedParagraph + containerXml.substring(pm.index + paragraph.length);
      }
    }

    // Fallback untuk paragraph self-closing (jarang pada template ini).
    var selfClosing = /<w:p\b([^>]*)\/>/;
    if (selfClosing.test(containerXml)) {
      return containerXml.replace(
        selfClosing,
        function(full, attrs) {
          var paragraph = '<w:p' + attrs + '></w:p>';
          return '<w:p' + attrs + '><w:r>' +
            r3InsertedRunPr_(paragraph) +
            r3TextXml_(text) +
            '</w:r></w:p>';
        }
      );
    }

    return containerXml;
  }

  var result = '';
  var last = 0;

  for (var i = 0; i < matches.length; i++) {
    result += containerXml.substring(last, matches[i].start);

    if (i === 0) {
      result += r3TextXml_(text);
    } else {
      result += '<w:t></w:t>';
    }

    last = matches[i].end;
  }

  result += containerXml.substring(last);
  return result;
}

function r3ReplaceExactText_(xml, oldText, newText, limit) {
  var oldEsc = r3XmlEscape_(oldText);
  var re = new RegExp(
    '<w:t([^>]*)>' +
    oldEsc.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') +
    '<\\/w:t>',
    'g'
  );

  var count = 0;

  return xml.replace(re, function(full, attrs) {
    if (limit && count >= limit) return full;
    count++;
    return '<w:t' + attrs + '>' + r3XmlEscape_(newText) + '</w:t>';
  });
}

function r3ReplaceParagraphByNeedle_(xml, needle, newText, occurrence) {
  occurrence = Number(occurrence) || 1;
  var re = /<w:p\b[\s\S]*?<\/w:p>/g;
  var count = 0;
  var m;

  while ((m = re.exec(xml)) !== null) {
    var block = m[0];
    var plain = r3StripXml_(block).replace(/\s+/g, ' ').trim();

    if (plain.indexOf(needle) >= 0) {
      count++;

      if (count === occurrence) {
        var replaced = r3ReplaceContainerText_(block, newText);
        return xml.substring(0, m.index) +
          replaced +
          xml.substring(m.index + block.length);
      }
    }
  }

  return xml;
}



/**
 * V20: isi nilai pada paragraf cover berdasarkan LABEL, bukan placeholder nama.
 */
function r3ReplaceParagraphValueAfterLabel_(xml, label, value, occurrence) {
  occurrence = Number(occurrence) || 1;
  var re = /<w:p\b[\s\S]*?<\/w:p>/g;
  var count = 0;
  var m;
  while ((m = re.exec(xml)) !== null) {
    var block = m[0];
    var plain = r3StripXml_(block).replace(/\s+/g, ' ').trim();
    if (plain.indexOf(label) < 0) continue;
    count++;
    if (count !== occurrence) continue;
    var colonRe = /<w:t([^>]*)>\s*:\s*<\/w:t>/g;
    var cm = colonRe.exec(block);
    if (!cm) throw new Error('Template cover berubah: tanda : setelah label '+label+' tidak ditemukan.');
    var headEnd = cm.index + cm[0].length;
    var head = block.substring(0, headEnd);
    var tail = block.substring(headEnd);
    var inserted = false;
    tail = tail.replace(/<w:t([^>]*)>([\s\S]*?)<\/w:t>/g, function(full, attrs, inner) {
      if (!inserted) {
        inserted = true;
        // Normalisasi atribut agar xml:space tidak dobel. Duplicate XML attributes
        // membuat DOCX invalid dan ditolak Google Docs dengan HTTP 400.
        var safeAttrs = String(attrs || '').replace(/\s+xml:space="[^"]*"/g, '');
        return '<w:t' + safeAttrs + ' xml:space="preserve">  ' + r3XmlEscape_(value || '-') + '</w:t>';
      }
      return '<w:t' + attrs + '></w:t>';
    });
    if (!inserted) {
      var close = tail.indexOf('</w:p>');
      if (close >= 0) {
        tail = tail.substring(0, close) + '<w:r>' + r3InsertedRunPr_(block) + '<w:t xml:space="preserve">  ' + r3XmlEscape_(value || '-') + '</w:t></w:r>' + tail.substring(close);
      }
    }
    return xml.substring(0, m.index) + head + tail + xml.substring(m.index + block.length);
  }
  throw new Error('Template cover berubah: label '+label+' tidak ditemukan.');
}

function r3AssertParagraphValueByLabel_(xml, label, value) {
  var re = /<w:p\b[\s\S]*?<\/w:p>/g;
  var m;
  var target = r3NormKey_(value);
  while ((m = re.exec(xml)) !== null) {
    var plain = r3StripXml_(m[0]).replace(/\s+/g, ' ').trim();
    if (plain.indexOf(label) < 0) continue;
    if (!target || r3NormKey_(plain).indexOf(target) >= 0) return true;
    throw new Error('Cover gagal diisi: nilai '+value+' belum masuk pada field '+label+'. Laporan dihentikan agar placeholder template tidak ikut tercetak.');
  }
  throw new Error('Template cover berubah: field '+label+' tidak ditemukan saat validasi.');
}

function r3Rows_(sheetName, auditId) {
  return getAllRows_(sheetName).filter(function(r) {
    return r3Clean_(r.AuditID) === r3Clean_(auditId);
  });
}

function r3DisplayCell_(sheetName, rowObj, fieldName) {
  if (!rowObj || !rowObj._row) return '';

  try {
    var headers = headers_(sheetName);
    var idx = headers.indexOf(fieldName);
    if (idx < 0) return '';

    return sheet_(sheetName)
      .getRange(Number(rowObj._row), idx + 1)
      .getDisplayValue();
  } catch (ignore) {
    return '';
  }
}

function r3Month_(m) {
  var a = [
    'Januari','Februari','Maret','April','Mei','Juni',
    'Juli','Agustus','September','Oktober','November','Desember'
  ];

  return a[Math.max(0, Math.min(11, Number(m) - 1))];
}

function r3DateId_(v) {
  if (v === null || v === undefined || v === '') return '-';

  if (v instanceof Date && !isNaN(v.getTime())) {
    var x = Utilities.formatDate(v, R3_TZ_, 'yyyy-MM-dd').split('-');
    return Number(x[2]) + ' ' + r3Month_(x[1]) + ' ' + x[0];
  }

  var s = String(v).trim();
  var iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);

  if (iso) {
    return Number(iso[3]) + ' ' + r3Month_(iso[2]) + ' ' + iso[1];
  }

  var id = s.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/);

  if (id) {
    return Number(id[1]) + ' ' + r3Month_(id[2]) + ' ' + id[3];
  }

  return s;
}

function r3TimeOnly_(v) {
  if (v === null || v === undefined || v === '') return '-';

  if (v instanceof Date && !isNaN(v.getTime())) {
    return Utilities.formatDate(v, R3_TZ_, 'HH.mm');
  }

  if (typeof v === 'number' && isFinite(v)) {
    var frac = v - Math.floor(v);
    if (frac < 0) frac += 1;

    var total = Math.round(frac * 24 * 60) % 1440;

    return ('0' + Math.floor(total / 60)).slice(-2) +
      '.' +
      ('0' + (total % 60)).slice(-2);
  }

  var s = String(v).trim();
  var simple = s.match(/^(\d{1,2})[.:](\d{2})/);

  if (simple) {
    return ('0' + simple[1]).slice(-2) + '.' + simple[2];
  }

  var all = s.match(/(?:^|[T\s])(\d{1,2}):(\d{2})(?::\d{2})?/g);

  if (all && all.length) {
    var last = all[all.length - 1].match(/(\d{1,2}):(\d{2})/);

    if (last) {
      return ('0' + last[1]).slice(-2) + '.' + last[2];
    }
  }

  return s;
}

function r3VisitDate_(ctx) {
  return r3DateId_(
    r3DisplayCell_('VISIT', ctx.visit, 'Tanggal') ||
    ctx.visit.Tanggal
  );
}

function r3VisitTime_(ctx) {
  var a =
    r3DisplayCell_('VISIT', ctx.visit, 'JamMulai') ||
    ctx.visit.JamMulai;

  var b =
    r3DisplayCell_('VISIT', ctx.visit, 'JamSelesai') ||
    ctx.visit.JamSelesai;

  var x = r3TimeOnly_(a);
  var y = r3TimeOnly_(b);

  if (x === '-' && y === '-') return '-';
  if (x !== '-' && y !== '-') return x + ' - ' + y + ' WIB';

  return (x !== '-' ? x : y) + ' WIB';
}

function r3FindingDate_(finding, fieldName) {
  return r3DateId_(
    r3DisplayCell_('FINDINGS', finding, fieldName) ||
    finding[fieldName]
  );
}

function r3DateTimeId_(v) {
  if (!v) return '-';

  if (v instanceof Date && !isNaN(v.getTime())) {
    var d = Utilities.formatDate(v, R3_TZ_, 'yyyy-MM-dd').split('-');
    var hm = Utilities.formatDate(v, R3_TZ_, 'HH.mm');

    return Number(d[2]) + ' ' + r3Month_(d[1]) + ' ' + d[0] +
      ', ' + hm + ' WIB';
  }

  var s = String(v).trim();
  var m = s.match(
    /^(\d{4})-(\d{2})-(\d{2})[T\s](\d{2}):(\d{2})(?::\d{2})?$/
  );

  if (m) {
    return Number(m[3]) + ' ' + r3Month_(m[2]) + ' ' + m[1] +
      ', ' + m[4] + '.' + m[5] + ' WIB';
  }

  return s;
}

function r3ParseArray_(s) {
  try {
    var x = JSON.parse(s || '[]');
    return Array.isArray(x) ? x : [];
  } catch (ignore) {
    return [];
  }
}

function r3ProgramForms_(form2) {
  form2=form2||{};
  var raw=r3ParseArray_(form2.LangkahJSON);
  if(typeof wfNormalizeProgramForms_==='function') return wfNormalizeProgramForms_(raw,form2);
  return raw.map(function(x,i){
    x=x||{};var ls=Array.isArray(x.langkahKerja)?x.langkahKerja:[];
    if(!ls.length&&(r3Clean_(x.uraian)||r3Clean_(x.estimasi)||r3Clean_(x.noPernyataan)||r3Clean_(x.realisasi)||r3Clean_(x.inisialAuditor)))ls=[{rowId:'R3_F2L_'+(i+1),uraian:x.uraian||'',estimasi:x.estimasi||'',noPernyataan:x.noPernyataan||'',realisasi:x.realisasi||'',inisialAuditor:x.inisialAuditor||''}];
    return {rowId:x.rowId||('R3_F2_'+(i+1)),nomorStandar:x.nomorStandar||'',namaStandar:x.namaStandar||'',tentatifAuditObjektif:x.tentatifAuditObjektif||(i===0?form2.TentatifAuditObjektif||'':''),tujuanAudit:x.tujuanAudit||(i===0?form2.TujuanAudit||'':''),langkahKerja:ls};
  });
}
function r3ProgramSteps_(form2) {
  var out=[];r3ProgramForms_(form2).forEach(function(p,pi){(Array.isArray(p.langkahKerja)?p.langkahKerja:[]).forEach(function(st,si){out.push({program:p,programIndex:pi,step:st||{},stepIndex:si});});});return out;
}
function r3AuditNotes_(form3) {
  form3=form3||{};var raw=r3ParseArray_(form3.CatatanJSON);
  if(typeof wfNormalizeAuditNotes_==='function') return wfNormalizeAuditNotes_(raw);
  return raw.map(function(x,i){x=x||{};var refs=Array.isArray(x.dokumenReferensi)?x.dokumenReferensi:(r3Clean_(x.dokumenRef)?[{rowId:'R3_F3R_'+(i+1),dokumenRef:x.dokumenRef}]:[]);return {rowId:x.rowId||('R3_F3_'+(i+1)),catatan:x.catatan||'',tanggal:x.tanggal||'',dokumenReferensi:refs};});
}
function r3ReferenceText_(note) {
  var refs=Array.isArray(note&&note.dokumenReferensi)?note.dokumenReferensi:[];
  var vals=refs.map(function(r){return r3Clean_(r&&r.dokumenRef);}).filter(Boolean);
  return vals.length?vals.map(function(v,i){return (i+1)+'. '+v;}).join('\n'):'-';
}

/* ============================ DATA ============================ */

function r3NormKey_(v) {
  return r3Clean_(v)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function r3PimpinanLevel_(v) {
  var x = r3NormKey_(v);
  if (/\bprodi\b|program studi/.test(x)) return 'PRODI';
  if (/\bunit\b|\bbiro\b/.test(x)) return 'UNIT';
  if (/fakultas/.test(x)) return 'FAKULTAS';
  if (/universitas/.test(x)) return 'UNIVERSITAS';
  if (/yayasan/.test(x)) return 'YAYASAN';
  return r3Clean_(v).toUpperCase();
}

/**
 * Cari pimpinan auditi langsung dari MASTER_PIMPINAN.
 * Report tidak boleh bergantung pada MASTER_PRODI.Kaprodi bila pimpinan Prodi
 * sudah ditetapkan melalui Area Akses pada Master Pimpinan.
 */
function r3FindPimpinanAuditi_(audit) {
  audit = audit || {};
  var type = r3Clean_(audit.AuditiType).toUpperCase();
  var auditId = r3Clean_(audit.AuditiID);
  var auditIdNorm = r3NormKey_(auditId);
  var auditName = r3NormKey_(audit.AuditiName);

  // V19: ambil identitas master auditi supaya Area Akses lama yang tersimpan
  // sebagai KodeProdi/KodeUnit tetap dapat dipetakan ke audit internal.
  var master = null;
  if (type === 'PRODI') {
    master = findOne_('MASTER_PRODI', 'ProdiID', auditId) || null;
  } else if (type === 'UNIT') {
    master = findOne_('MASTER_UNIT', 'UnitID', auditId) || null;
  }

  var targetIds = {};
  function addTargetId_(v) {
    var k = r3NormKey_(v);
    if (k) targetIds[k] = true;
  }
  addTargetId_(auditId);
  if (master) {
    if (type === 'PRODI') {
      addTargetId_(master.ProdiID);
      addTargetId_(master.KodeProdi);
    } else {
      addTargetId_(master.UnitID);
      addTargetId_(master.KodeUnit);
    }
  }

  var targetNames = [];
  function addTargetName_(v) {
    var k = r3NormKey_(v);
    if (k && targetNames.indexOf(k) < 0) targetNames.push(k);
  }
  addTargetName_(audit.AuditiName);
  if (master) {
    addTargetName_(type === 'PRODI' ? master.NamaProdi : master.NamaUnit);
  }

  function areaNameScore_(value) {
    var k = r3NormKey_(value);
    if (!k) return 0;
    var best = 0;
    targetNames.forEach(function(n) {
      if (!n) return;
      if (k === n) best = Math.max(best, 100);
      else if ((' ' + k + ' ').indexOf(' ' + n + ' ') >= 0 ||
               (' ' + n + ' ').indexOf(' ' + k + ' ') >= 0) {
        best = Math.max(best, 85);
      } else if (k.indexOf(n) >= 0 || n.indexOf(k) >= 0) {
        best = Math.max(best, 75);
      }
    });
    return best;
  }

  function idScore_(value) {
    var k = r3NormKey_(value);
    return k && targetIds[k] ? 110 : 0;
  }

  var rows = getAllRows_('MASTER_PIMPINAN').filter(function(p) {
    return bool_(p.Active);
  });

  var ranked = rows.map(function(p, idx) {
    var level = r3PimpinanLevel_(p.Level);
    var accessType = r3PimpinanLevel_(p.AccessType);
    var accessId = r3Clean_(p.AccessID);
    var unitId = r3Clean_(p.UnitID);
    var accessName = r3Clean_(p.AccessName);
    var jabatanNorm = r3NormKey_(p.Jabatan);

    var score = 0;
    var matchedArea = false;

    var sid = Math.max(idScore_(accessId), idScore_(unitId));
    var sname = areaNameScore_(accessName);
    var sjabatanArea = areaNameScore_(p.Jabatan);

    if (sid) {
      score += sid;
      matchedArea = true;
    }
    if (sname) {
      score += sname;
      matchedArea = true;
    }
    // Data lama kadang menulis "Ketua Program Studi Biologi" di kolom Jabatan
    // tanpa AccessName. Tetap dapat dikenali selama nama auditi ada di Jabatan.
    if (sjabatanArea) {
      score += Math.min(sjabatanArea, 90);
      matchedArea = true;
    }

    if (type === 'PRODI') {
      if (level === 'PRODI' || accessType === 'PRODI') score += 45;
      if (/ketua program studi|ketua prodi|ka prodi|kaprodi/.test(jabatanNorm)) score += 35;
      else if (/program studi|prodi/.test(jabatanNorm)) score += 15;
    } else if (type === 'UNIT') {
      if (level === 'UNIT' || accessType === 'UNIT') score += 45;
      if (/kepala|ketua|direktur/.test(jabatanNorm)) score += 20;
    }

    // Jangan pernah memilih pimpinan area lain hanya karena jabatannya generik.
    if (!matchedArea) score = 0;

    var updated = 0;
    try {
      updated = p.UpdatedAt instanceof Date
        ? p.UpdatedAt.getTime()
        : (Date.parse(p.UpdatedAt || p.CreatedAt || '') || 0);
    } catch (ignoreUpdated) {}

    return {row:p, score:score, idx:idx, updated:updated};
  }).filter(function(x) {
    return x.score > 0;
  });

  ranked.sort(function(a, b) {
    return b.score - a.score || b.updated - a.updated || a.idx - b.idx;
  });

  return ranked.length ? ranked[0].row : null;
}

function r3Signatories_(audit) {
  // Sumber utama: MASTER_PIMPINAN yang cocok dengan Area Akses auditi.
  // Helper approval tetap menjadi fallback untuk kompatibilitas project lama.
  var pa = r3FindPimpinanAuditi_(audit);

  if (!pa && typeof getPimpinanApproversForAudit_ === 'function') {
    var list = getPimpinanApproversForAudit_(audit) || [];
    if (list.length) pa = list[0];
  }

  var bpm = getAllRows_('MASTER_PIMPINAN')
      .filter(function(p) {
        return bool_(p.Active);
      })
      .find(function(p) {
        var txt = [
          p.Jabatan,
          p.AccessName,
          p.Nama
        ].map(r3Clean_).join(' ').toLowerCase();

        return /kepala.*biro.*penjaminan.*mutu|kepala.*bpm|ka\.?\s*bpm/.test(txt);
      }) || null;

  return {pimpinan:pa, bpm:bpm};
}

function r3CycleLabel_(cycle) {
  var name = r3Clean_(cycle.NamaSiklus);
  var year = r3Clean_(cycle.Tahun);

  var roman = name.match(/\b([IVXLCDM]+)\b/i);

  if (roman && year) return roman[1].toUpperCase() + '/' + year;

  var n = name.match(/siklus\s*([0-9]+)/i);

  if (n && year) return n[1] + '/' + year;

  if (year) return year;
  return name || '-';
}

function r3CycleFull_(cycle) {
  return r3Clean_(cycle.NamaSiklus) ||
    (r3Clean_(cycle.Tahun) ? 'AMI Tahun ' + r3Clean_(cycle.Tahun) : '-');
}

function r3Context_(auditId) {
  var audit = findOne_('AMI_AUDITI', 'AuditID', auditId);

  if (!audit) {
    throw new Error('Audit tidak ditemukan.');
  }

  var cycle =
    findOne_('AMI_CYCLE', 'CycleID', audit.CycleID) || {};

  var team =
    findOne_('AMI_TEAM', 'AuditID', auditId) || {};

  var auditors = {};

  getAllRows_('MASTER_AUDITOR').forEach(function(a) {
    auditors[r3Clean_(a.AuditorID)] = a;
  });

  var masters = {};

  getAllRows_('MASTER_STANDAR').forEach(function(s) {
    masters[r3Clean_(s.StandardID)] = s;
  });

  var assigns = r3Rows_('AMI_STANDARD_ASSIGN', auditId)
    .filter(function(a) {
      return bool_(a.Active);
    });

  assigns.sort(function(a, b) {
    return r3Clean_(a.ItemCode)
      .localeCompare(
        r3Clean_(b.ItemCode),
        undefined,
        {numeric:true}
      );
  });

  var self = {};
  r3Rows_('SELF_EVAL', auditId).forEach(function(x) {
    self[r3Clean_(x.AssignID)] = x;
  });

  var desk = {};
  r3Rows_('DESK_EVAL', auditId).forEach(function(x) {
    desk[r3Clean_(x.AssignID)] = x;
  });

  var finding = {};
  r3Rows_('FINDINGS', auditId).forEach(function(x) {
    finding[r3Clean_(x.AssignID)] = x;
  });

  var improvement = {};

  try {
    if (db_().getSheetByName('AMI_IMPROVEMENT')) {
      r3Rows_('AMI_IMPROVEMENT', auditId).forEach(function(x) {
        improvement[r3Clean_(x.AssignID)] = x;
      });
    }
  } catch (ignoreImprovement) {
    improvement = {};
  }

  var evidence = {};
  r3Rows_('EVIDENCE', auditId).forEach(function(x) {
    var k = r3Clean_(x.StandardID);

    if (!evidence[k]) evidence[k] = [];
    evidence[k].push(x);
  });

  var visit = r3Rows_('VISIT', auditId)[0] || {};
  var form2 = r3Rows_('FORM2_PROGRAM_KERJA', auditId)[0] || {};
  var form3 = r3Rows_('FORM3_CATATAN', auditId)[0] || {};

  var approvals = {};

  r3Rows_('APPROVAL', auditId).forEach(function(x) {
    if (bool_(x.Approved)) {
      approvals[r3Clean_(x.Stage)] = x;
    }
  });

  var signs = r3Signatories_(audit);

  var leader = {
    label:'Pimpinan Auditi',
    name:signs.pimpinan ? r3Clean_(signs.pimpinan.Nama) : ''
  };

  if (r3Clean_(audit.AuditiType) === 'PRODI') {
    var prodi = findOne_(
      'MASTER_PRODI',
      'ProdiID',
      audit.AuditiID
    );

    if (prodi) {
      leader.label = 'Ka. Prodi';
      // V20: Ka. Prodi wajib berasal dari MASTER_PIMPINAN yang dipetakan ke Prodi.
      // MASTER_PRODI.Kaprodi tidak lagi digunakan sebagai fallback.
    }
  } else {
    var unit = findOne_(
      'MASTER_UNIT',
      'UnitID',
      audit.AuditiID
    );

    if (unit) {
      leader.label =
        /BIRO/i.test(r3Clean_(unit.JenisUnit))
          ? 'Ka. Biro'
          : 'Pimpinan Unit';

      leader.name =
        r3Clean_(unit.Pimpinan) ||
        leader.name;
    }
  }

  var counts = {
    'MELAMPAUI':0,
    'MENCAPAI':0,
    'BELUM MENCAPAI':0,
    'MENYIMPANG':0
  };

  assigns.forEach(function(a) {
    var f =
      finding[r3Clean_(a.AssignID)] || {};

    var c = r31NormalizeCategory_(f.Kategori);

    if (Object.prototype.hasOwnProperty.call(counts, c)) {
      counts[c]++;
    }
  });

  return {
    audit:audit,
    cycle:cycle,
    team:team,
    auditors:auditors,
    masters:masters,
    assigns:assigns,
    self:self,
    desk:desk,
    finding:finding,
    improvement:improvement,
    evidence:evidence,
    visit:visit,
    form2:form2,
    form3:form3,
    approvals:approvals,
    signatories:signs,
    leader:leader,
    counts:counts
  };
}

function r3Entry_(ctx, a) {
  var aid = r3Clean_(a.AssignID);
  var sid = r3Clean_(a.StandardID);

  return {
    assign:a,
    master:ctx.masters[sid] || {},
    self:ctx.self[aid] || {},
    desk:ctx.desk[aid] || {},
    finding:ctx.finding[aid] || {},
    improvement:ctx.improvement[aid] || {},
    evidence:ctx.evidence[sid] || []
  };
}


function r31NormalizeCategory_(v) {
  var x = r3Clean_(v).toUpperCase();
  x = x.replace(/\s+/g, ' ').trim();

  if (x === 'MELAMPAUI') return 'MELAMPAUI';
  if (x === 'MENCAPAI') return 'MENCAPAI';
  if (x === 'BELUM MENCAPAI' || x === 'BELUM_MENCAPAI') return 'BELUM MENCAPAI';
  if (x === 'MENYIMPANG') return 'MENYIMPANG';

  return '';
}

function r31EntryCategory_(entry) {
  return r31NormalizeCategory_(
    entry && entry.finding
      ? entry.finding.Kategori
      : ''
  );
}

function r31FinalReadiness_(ctx) {
  var errors = [];
  var warnings = [];

  if (!ctx.assigns.length) {
    errors.push('Belum ada standar yang ditetapkan pada audit.');
  }

  var lead =
    ctx.auditors[
      r3Clean_(ctx.team.LeadAuditorID)
    ] || {};

  var m1 =
    ctx.auditors[
      r3Clean_(ctx.team.Member1ID)
    ] || {};

  var m2 =
    ctx.auditors[
      r3Clean_(ctx.team.Member2ID)
    ] || {};

  if (!r3Clean_(lead.Nama)) {
    errors.push('Ketua Tim Auditor belum tersedia.');
  }

  if (!r3Clean_(m1.Nama)) {
    errors.push('Anggota Auditor 1 belum tersedia.');
  }

  if (!r3Clean_(m2.Nama)) {
    errors.push('Anggota Auditor 2 belum tersedia.');
  }

  var missingResult = [];

  ctx.assigns.forEach(function(a) {
    var e = r3Entry_(ctx, a);
    var cat = r31EntryCategory_(e);

    if (!cat) {
      missingResult.push(
        r3Clean_(a.ItemCode) ||
        r3Clean_(a.NamaStandar) ||
        r3Clean_(a.AssignID)
      );
      return;
    }

    if (
      (
        cat === 'BELUM MENCAPAI' ||
        cat === 'MENYIMPANG'
      ) &&
      !r3Clean_(e.finding.Deskripsi)
    ) {
      warnings.push(
        'Deskripsi temuan belum diisi untuk ' +
        (
          r3Clean_(a.ItemCode) ||
          r3Clean_(a.NamaStandar)
        ) +
        '.'
      );
    }

    if (
      cat === 'MENCAPAI' ||
      cat === 'MELAMPAUI'
    ) {
      if (!r3Clean_(e.improvement.FaktorPendukung)) {
        errors.push(
          (
            r3Clean_(a.ItemCode) ||
            r3Clean_(a.NamaStandar)
          ) +
          ': Faktor Pendukung belum tersedia.'
        );
      }

      if (
        !r3Clean_(
          e.improvement.RekomendasiPeningkatanIndikator
        )
      ) {
        errors.push(
          (
            r3Clean_(a.ItemCode) ||
            r3Clean_(a.NamaStandar)
          ) +
          ': Rekomendasi Peningkatan Indikator belum tersedia.'
        );
      }
    }
  });

  if (missingResult.length) {
    errors.push(
      'Hasil auditor belum lengkap untuk ' +
      missingResult.length +
      ' butir: ' +
      missingResult.slice(0, 10).join(', ') +
      (
        missingResult.length > 10
          ? ' dan ' +
            (missingResult.length - 10) +
            ' butir lainnya'
          : ''
      ) +
      '.'
    );
  }

  if (!r3Clean_(ctx.visit.Tanggal)) {
    warnings.push('Tanggal visitasi belum tersedia.');
  }

  if (!r3Clean_(ctx.visit.Lokasi)) {
    warnings.push('Lokasi visitasi belum tersedia.');
  }

  var reportPrograms=r3ProgramForms_(ctx.form2);
  if (!reportPrograms.length || reportPrograms.some(function(p){return !r3Clean_(p&&p.tujuanAudit);})) {
    warnings.push('Tujuan Audit pada satu atau lebih Program Kerja belum diisi.');
  }
  if (reportPrograms.some(function(p){return !r3Clean_(p&&p.nomorStandar)||!r3Clean_(p&&p.namaStandar);})) {
    warnings.push('Nomor Standar atau Nama Standar pada satu atau lebih Program Kerja belum diisi; laporan akan memakai fallback data audit lama bila tersedia.');
  }
  var reportSteps=r3ProgramSteps_(ctx.form2).filter(function(x){return r3Clean_(x&&x.step&&x.step.uraian);});
  if (!reportSteps.length) warnings.push('Program Kerja Audit belum memiliki langkah kerja yang dapat ditampilkan.');
  var reportNotes=r3AuditNotes_(ctx.form3).filter(function(x){return r3Clean_(x&&x.catatan);});
  if (!reportNotes.length) warnings.push('Catatan Auditor belum memiliki catatan yang dapat ditampilkan.');

  return {
    ok:errors.length === 0,
    errors:errors,
    warnings:warnings
  };
}

function r3Assessed_(ctx) {
  var c = ctx.counts;

  return Number(c.MELAMPAUI || 0) +
    Number(c.MENCAPAI || 0) +
    Number(c['BELUM MENCAPAI'] || 0) +
    Number(c.MENYIMPANG || 0);
}

function r3FulfillPct_(ctx) {
  var total = r3Assessed_(ctx);

  if (!total) return 0;

  return Math.round(
    (
      Number(ctx.counts.MELAMPAUI || 0) +
      Number(ctx.counts.MENCAPAI || 0)
    ) * 100 / total
  );
}

function r3GroupName_(entry) {
  var raw = r3Clean_(
    entry.assign.KelompokSnapshot ||
    entry.master.Kelompok ||
    entry.assign.KodeKelompokSnapshot
  ).toUpperCase();

  if (/PENDIDIKAN|MBKM/.test(raw)) return 'PENDIDIKAN';
  if (/PENELITIAN/.test(raw)) return 'PENELITIAN';
  if (/PENGABDIAN|PKM/.test(raw)) return 'PENGABDIAN';
  if (/MELAMPAUI/.test(raw)) return 'MELAMPAUI';

  return 'LAINNYA';
}

function r3GroupStats_(ctx) {
  var names = [
    'PENDIDIKAN',
    'PENELITIAN',
    'PENGABDIAN',
    'MELAMPAUI'
  ];

  var out = {};

  names.forEach(function(n) {
    out[n] = {
      'MELAMPAUI':0,
      'MENCAPAI':0,
      'BELUM MENCAPAI':0,
      'MENYIMPANG':0
    };
  });

  ctx.assigns.forEach(function(a) {
    var e = r3Entry_(ctx, a);
    var g = r3GroupName_(e);
    var c = r31EntryCategory_(e);

    if (!out[g]) return;

    if (Object.prototype.hasOwnProperty.call(out[g], c)) {
      out[g][c]++;
    }
  });

  return out;
}

function r3StatementNo_(entry) {
  var n = r3Clean_(entry.master.NoSumber);
  if (n) return n;

  var code = r3Clean_(entry.assign.ItemCode);
  var m = code.match(/-(\d+)$/);

  if (m) return String(Number(m[1]));

  return '-';
}

function r3EvidenceUrl_(e) {
  var url = r3Clean_(e.URL);

  if (!url && r3Clean_(e.DriveFileID)) {
    url =
      'https://drive.google.com/file/d/' +
      encodeURIComponent(r3Clean_(e.DriveFileID)) +
      '/view';
  }

  return url;
}

function r3CanAccess_(u, audit) {
  if (!u || !audit) return false;
  if (r3Clean_(u.Role) === 'ADMIN_BPM') return true;

  if (typeof filterAuditsForUser_ === 'function') {
    return filterAuditsForUser_(u, [audit]).length > 0;
  }

  return false;
}

/* ============================ DOCX XML ============================ */

function r3TemplateParts_() {
  var bytes =
    Utilities.base64Decode(R3_TEMPLATE_B64_);

  var zipBlob =
    Utilities.newBlob(
      bytes,
      'application/zip',
      'AMI_Template_V3.zip'
    );

  var blobs = Utilities.unzip(zipBlob);
  var map = {};

  blobs.forEach(function(b) {
    map[b.getName()] = b;
  });

  return map;
}

function r3TableBlocks_(xml) {
  return xml.match(
    /<w:tbl\b[\s\S]*?<\/w:tbl>/g
  ) || [];
}

function r3RowBlocks_(tableXml) {
  return tableXml.match(
    /<w:tr\b[\s\S]*?<\/w:tr>/g
  ) || [];
}

function r3CellBlocks_(rowXml) {
  return rowXml.match(
    /<w:tc\b[\s\S]*?<\/w:tc>/g
  ) || [];
}

function r3RebuildTable_(tableXml, rows) {
  var oldRows = r3RowBlocks_(tableXml);

  if (!oldRows.length) return tableXml;

  var first = tableXml.indexOf(oldRows[0]);
  var lastBlock = oldRows[oldRows.length - 1];
  var last = tableXml.lastIndexOf(lastBlock);

  return tableXml.substring(0, first) +
    rows.join('') +
    tableXml.substring(last + lastBlock.length);
}

function r3RebuildRow_(rowXml, cells) {
  var oldCells = r3CellBlocks_(rowXml);

  if (!oldCells.length) return rowXml;

  var first = rowXml.indexOf(oldCells[0]);
  var lastBlock = oldCells[oldCells.length - 1];
  var last = rowXml.lastIndexOf(lastBlock);

  return rowXml.substring(0, first) +
    cells.join('') +
    rowXml.substring(last + lastBlock.length);
}

function r3SetRowCellText_(rowXml, cellIndex, value) {
  var cells = r3CellBlocks_(rowXml);

  if (cellIndex < 0 || cellIndex >= cells.length) {
    return rowXml;
  }

  cells[cellIndex] =
    r3ReplaceContainerText_(
      cells[cellIndex],
      value
    );

  // Sebagian placeholder tersembunyi pada template (khusus Program Kerja)
  // menggunakan font putih. Saat diganti dengan data aplikasi, pastikan nilai
  // tidak tetap tersembunyi di atas latar putih.
  if (String(value == null ? '' : value).trim()) {
    cells[cellIndex] = cells[cellIndex].replace(
      /<w:color\b([^>]*)w:val="FFFFFF"([^>]*)\/>/gi,
      '<w:color$1w:val="000000"$2/>'
    );
  }

  return r3RebuildRow_(rowXml, cells);
}

function r3SetRowCellColor_(rowXml, cellIndex, hex) {
  var cells = r3CellBlocks_(rowXml);

  if (cellIndex < 0 || cellIndex >= cells.length) {
    return rowXml;
  }

  var cell = cells[cellIndex];
  var touched = false;

  // Terapkan pada semua run properties (paragraph mark maupun run aktual),
  // sehingga warna tetap bekerja juga untuk teks yang baru disisipkan ke sel kosong.
  cell = cell.replace(
    /<w:rPr>([\s\S]*?)<\/w:rPr>/g,
    function(full, inner) {
      touched = true;
      var x = inner;
      if (/<w:color\b/.test(x)) {
        x = x.replace(/<w:color\b[^>]*\/>/g, '<w:color w:val="' + hex + '"/>');
      } else {
        x += '<w:color w:val="' + hex + '"/>';
      }
      return '<w:rPr>' + x + '</w:rPr>';
    }
  );

  if (!touched) {
    // r3ReplaceContainerText_ normalnya sudah membuat rPr; fallback ini
    // menjaga kompatibilitas jika template diubah kemudian.
    cell = cell.replace(
      /<w:r\b([^>]*)>/,
      '<w:r$1><w:rPr><w:color w:val="' + hex + '"/></w:rPr>'
    );
  }

  cells[cellIndex] = cell;
  return r3RebuildRow_(rowXml, cells);
}

function r3ReplaceTableIndex_(xml, index, newTableXml) {
  var re = /<w:tbl\b[\s\S]*?<\/w:tbl>/g;
  var i = 0;
  var m;

  while ((m = re.exec(xml)) !== null) {
    if (i === index) {
      return xml.substring(0, m.index) +
        newTableXml +
        xml.substring(re.lastIndex);
    }

    i++;
  }

  throw new Error(
    'Template berubah: tabel index ' +
    index +
    ' tidak ditemukan.'
  );
}

/**
 * Template resmi memiliki banyak paragraf kosong sebagai spacer agar tabel
 * contoh memenuhi satu halaman. Setelah tabel dibuat dinamis, spacer tersebut
 * dapat mendorong judul terlalu ke bawah atau bahkan membuat halaman kosong.
 * Hapus hanya paragraf kosong di antara tabel terakhir dan heading tujuan;
 * page break serta section break selalu dipertahankan.
 */
function r3CompactSpacerBeforeHeading_(xml, needle) {
  xml = String(xml || '');
  needle = String(needle || '');
  if (!needle) return xml;

  var pRe = /<w:p\b[^>]*>[\s\S]*?<\/w:p>/g;
  var m;
  var headingStart = -1;

  while ((m = pRe.exec(xml)) !== null) {
    var plain = r3StripXml_(m[0]).replace(/\s+/g, ' ').trim();
    if (plain.indexOf(needle) >= 0) {
      headingStart = m.index;
      break;
    }
  }

  if (headingStart < 0) return xml;

  var tableEndTag = '</w:tbl>';
  var lastTableEnd = xml.lastIndexOf(tableEndTag, headingStart);
  if (lastTableEnd < 0) return xml;

  var segmentStart = lastTableEnd + tableEndTag.length;
  var segment = xml.substring(segmentStart, headingStart);

  segment = segment.replace(/<w:p\b[^>]*>[\s\S]*?<\/w:p>/g, function(p) {
    var plain = r3StripXml_(p).replace(/\s+/g, ' ').trim();
    if (plain) return p;
    if (/<w:br\b[^>]*w:type=[\"']page[\"'][^>]*\/?\s*>/i.test(p)) return p;
    if (/<w:sectPr\b/i.test(p)) return p;
    return '';
  });

  return xml.substring(0, segmentStart) + segment + xml.substring(headingStart);
}

function r3PageBreakParagraph_() {
  return '<w:p><w:r><w:br w:type="page"/></w:r></w:p>';
}

function r3BuildSimpleRows_(
  baseRow,
  minRows,
  data,
  fillFn
) {
  var count = Math.max(minRows, data.length);
  var out = [];

  for (var i = 0; i < count; i++) {
    var row = baseRow;

    if (i < data.length) {
      row = fillFn(row, data[i], i);
    } else {
      var cells = r3CellBlocks_(row);

      for (var c = 0; c < cells.length; c++) {
        cells[c] =
          r3ReplaceContainerText_(
            cells[c],
            ''
          );
      }

      row = r3RebuildRow_(row, cells);
    }

    out.push(row);
  }

  return out;
}

/* ============================ TABLE PATCH ============================ */

function r3PatchApprovalInfoTable_(tbl, ctx) {
  var rows = r3RowBlocks_(tbl);
  var audit = ctx.audit;

  var isProdi =
    r3Clean_(audit.AuditiType) === 'PRODI';

  var values = [
    [
      isProdi ? 'Program Studi' : 'Unit',
      r3Clean_(audit.AuditiName) || '-'
    ],
    [
      'Fakultas / Unit',
      isProdi
        ? (r3Clean_(audit.Fakultas) || '-')
        : (r3Clean_(audit.AuditiName) || '-')
    ],
    [
      'Siklus / Tahun',
      r3CycleFull_(ctx.cycle)
    ],
    [
      'Tanggal Visitasi',
      r3VisitDate_(ctx)
    ],
    [
      'Lokasi',
      r3Clean_(ctx.visit.Lokasi) || '-'
    ]
  ];

  for (var i = 0; i < values.length && i < rows.length; i++) {
    rows[i] =
      r3SetRowCellText_(
        rows[i],
        0,
        values[i][0]
      );

    rows[i] =
      r3SetRowCellText_(
        rows[i],
        1,
        values[i][1]
      );
  }

  return r3RebuildTable_(tbl, rows);
}

function r3PatchSignatureTable_(tbl, ctx) {
  var rows = r3RowBlocks_(tbl);

  var lead =
    ctx.auditors[
      r3Clean_(ctx.team.LeadAuditorID)
    ] || {};

  var pa = ctx.signatories.pimpinan || {};
  var bpm = ctx.signatories.bpm || {};

  var names = [
    r3Clean_(pa.Nama) ||
      ctx.leader.name ||
      '-',
    r3Clean_(lead.Nama) || '-',
    r3Clean_(bpm.Nama) || '-'
  ];

  var jobs = [
    r3Clean_(pa.Jabatan) ||
      ctx.leader.label ||
      'Pimpinan Auditi',
    'Ketua Tim Auditor',
    r3Clean_(bpm.Jabatan) ||
      'Kepala Biro Penjaminan Mutu'
  ];

  if (rows.length >= 4) {
    for (var c = 0; c < 3; c++) {
      rows[2] =
        r3SetRowCellText_(
          rows[2],
          c,
          names[c]
        );

      rows[3] =
        r3SetRowCellText_(
          rows[3],
          c,
          jobs[c]
        );
    }
  }

  return r3RebuildTable_(tbl, rows);
}

function r3PatchTocTable_(tbl, ctx) {
  var rows = r3RowBlocks_(tbl);

  // Nomor mengikuti layout dasar template:
  // cover tidak bernomor; Ringkasan Eksekutif menggunakan dua halaman.
  var negCount = r3NegativeEntries_(ctx).length;
  var priorityPages = Math.max(1, negCount);

  var resultExtra =
    Math.max(
      0,
      Math.ceil(
        Math.max(7, ctx.assigns.length) / 12
      ) - 1
    );

  var positiveCount =
    r3PositiveEntries_(ctx).length;

  var improvementExtra =
    Math.max(
      0,
      Math.ceil(
        Math.max(7, positiveCount) / 14
      ) - 1
    );

  var notesCount =
    r3AuditNotes_(ctx.form3).length;

  var notesExtra =
    Math.max(
      0,
      Math.ceil(
        Math.max(5, notesCount) / 18
      ) - 1
    );

  var evidenceCount = 0;

  Object.keys(ctx.evidence).forEach(function(k) {
    evidenceCount += ctx.evidence[k].length;
  });

  var evidenceExtra =
    Math.max(
      0,
      Math.ceil(
        Math.max(1, evidenceCount) / 20
      ) - 1
    );

  var page = {
    approval:1,
    toc:2,
    executive:3,
    intro:5,
    result:6,
    priority:7 + resultExtra,
    improvement:
      7 +
      resultExtra +
      priorityPages,
    conclusion:
      8 +
      resultExtra +
      priorityPages +
      improvementExtra,
    notes:
      9 +
      resultExtra +
      priorityPages +
      improvementExtra,
    evidence:
      10 +
      resultExtra +
      priorityPages +
      improvementExtra +
      notesExtra,
    program:
      11 +
      resultExtra +
      priorityPages +
      improvementExtra +
      notesExtra +
      evidenceExtra
  };

  var pages = [
    page.approval,
    page.toc,
    page.executive,
    page.intro,
    page.result,
    page.priority,
    page.improvement,
    page.conclusion,
    page.notes,
    page.evidence,
    page.program
  ];

  for (var i = 0; i < rows.length && i < pages.length; i++) {
    rows[i] =
