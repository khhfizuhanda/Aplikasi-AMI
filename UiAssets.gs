/** Embedded UI assets supplied for AMI 2026. Self-contained: no public Drive permissions required. */
const BPM_LOGO_BASE64 = '';
const SPMI_LOGO_BASE64 = '';
const CAMPUS_HERO_BASE64 = '';
function getUiAssets_(){return{bpmLogo:'data:image/png;base64,'+BPM_LOGO_BASE64,spmiLogo:'data:image/png;base64,'+SPMI_LOGO_BASE64,campusHero:'data:image/jpeg;base64,'+CAMPUS_HERO_BASE64};}
function getBpmLogoBlob_(){return Utilities.newBlob(Utilities.base64Decode(BPM_LOGO_BASE64),'image/png','Logo BPM UMA.png');}
function getSpmiLogoBlob_(){return Utilities.newBlob(Utilities.base64Decode(SPMI_LOGO_BASE64),'image/png','Logo SPMI UMA.png');}
